<?xml version="1.0" encoding="utf-8"?>
<!--
  Fekvő elrendezés: a pálya balra, a vezérlés jobbra. Az azonosítók megegyeznek
  az álló változatéval, így a Wormgame kódja változatlanul működik. A pálya
  négyzetes és a rendelkezésre álló magassághoz igazodik – a cella méretét a
  kód a tényleges méretből számolja.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Wormgame">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:background="@color/white"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/new_game"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:background="@color/black"
            android:text="@string/button_gameover_name"
            android:textAlignment="center"
            android:textSize="15sp" />

        <Button
            android:id="@+id/new_game"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@color/purple_700"
            android:text="@string/button_newgame_name" />

        <Button
            android:id="@+id/resume"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/new_game"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@color/purple_700"
            android:text="@string/button_resume_name"
            android:textAlignment="center" />

        <Button
            android:id="@+id/playagain"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/resume"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:background="@color/red"
            android:text="@string/button_gameover_name"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- A pálya utoljára, hogy a fenti gombok fölé kerüljön – ugyanúgy,
             mint az álló elrendezésben. -->
        <RelativeLayout
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:background="@color/black"
            android:gravity="center" />

    </RelativeLayout>

    <Button
        android:id="@+id/score2"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/green"
        android:text="@string/button_score_name"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/lilu"
        app:layout_constraintStart_toStartOf="@+id/lilu"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/lilu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/relativeLayout"
        app:layout_constraintTop_toBottomOf="@+id/score2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/up"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="@string/button_up_name" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/left"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="@string/button_left_name" />

            <Button
                android:id="@+id/pause"
                android:layout_width="wrap_content"
                android:layout_height="75dp"
                android:gravity="center"
                android:text="@string/button_pause_name" />

            <Button
                android:id="@+id/right"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="@string/button_right_name" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/down"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_margin="4dp"
                android:gravity="center"
                android:text="@string/button_down_name" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
